# Vox Local-First Configuration
# Copy this file to .env and fill in your values

# FastAPI Secret Key for session management
FASTAPI_SECRET_KEY=your-secret-key-here-change-me

# OpenAI-Compatible API Configuration
# This works with OpenAI, OpenRouter, or any OpenAI-compatible API
OPENAI_API_KEY=your-api-key-here
# Optional: Set a custom API base URL (e.g., for OpenRouter or other providers)
# For OpenRouter, use: https://openrouter.ai/api/v1
# Leave blank for default OpenAI API
OPENAI_API_BASE=

# Optional: Specify the model to use
# Default: gpt-3.5-turbo
# Examples: gpt-4, gpt-4-turbo, or for OpenRouter: google/gemini-2.0-flash-001
OPENAI_MODEL=gpt-3.5-turbo

# Database Configuration
# Path to the SQLite database file (default: vox_data.db in the app directory)
DATABASE_PATH=vox_data.db
